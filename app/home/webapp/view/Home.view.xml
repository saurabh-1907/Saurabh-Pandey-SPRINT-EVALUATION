<mvc:View
    controllerName="psa.home.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    displayBlock="true"
    height="100%">

    <Page id="page" showHeader="false" class="psaHome" backgroundDesign="List">

        <!-- ================= Welcome banner ================= -->
        <VBox class="psaHero">
            <HBox justifyContent="SpaceBetween" alignItems="Start" wrap="Wrap">
                <VBox class="sapUiSmallMarginEnd">
                    <Text text="{home>/today}" class="psaHeroDate" />
                    <Title text="{home>/greeting}" level="H1" wrapping="true" class="psaHeroTitle" />
                    <Text text="{home>/summary}" class="psaHeroText" />
                </VBox>
                <ObjectStatus text="{= ${home>/me/isAdmin} ? 'Admin' : 'Employee' }" inverted="true" state="Information"
                    icon="{= ${home>/me/isAdmin} ? 'sap-icon://manager' : 'sap-icon://employee' }" class="psaRole" />
            </HBox>
            <HBox wrap="Wrap" class="psaHeroActions">
                <Button text="{home>/week/action}" icon="sap-icon://create-entry-time" press=".onLogTime"
                    visible="{= !!${home>/kpi/myEmployeeID} }" class="psaHeroButton psaHeroButtonMain" />
                <Button text="Approve timesheets" icon="sap-icon://approvals" press=".onNavigate" app:target="#Timesheet-approve"
                    visible="{= !!${home>/me/isAdmin} }" class="psaHeroButton" />
                <Button text="Generate invoice" icon="sap-icon://receipt" press=".onNavigate" app:target="#Invoice-manage"
                    visible="{= !!${home>/me/isAdmin} }" class="psaHeroButton" />
                <Button text="Projects" icon="sap-icon://project-definition-triangle-2" press=".onNavigate" app:target="#Project-manage"
                    visible="{= !!${home>/me/isAdmin} }" class="psaHeroButton" />
            </HBox>
        </VBox>

        <!-- ================= KPI strip ================= -->
        <HBox wrap="Wrap" class="psaKpis">
            <items>
                <!-- Admin (FRD 9: Manager Home + Billing Workbench) -->
                <f:Card width="100%" height="100%" class="psaKpi" visible="{= !!${home>/me/isAdmin} }">
                    <f:header>
                        <card:NumericHeader title="Active Projects" subtitle="Running today" iconSrc="sap-icon://project-definition-triangle-2"
                            iconBackgroundColor="Accent6" number="{path: 'home>/kpi/activeProjects', formatter: '.formatCount'}"
                            state="Neutral" press=".onNavigate" app:target="#Project-manage" />
                    </f:header>
                </f:Card>
                <f:Card width="100%" height="100%" class="psaKpi" visible="{= !!${home>/me/isAdmin} }">
                    <f:header>
                        <card:NumericHeader title="At-Risk Budgets" subtitle="Burn of 80 % or more" iconSrc="sap-icon://alert"
                            iconBackgroundColor="Accent2" number="{path: 'home>/kpi/atRiskBudgets', formatter: '.formatCount'}"
                            state="{= ${home>/kpi/atRiskBudgets} > 0 ? 'Error' : 'Good' }"
                            details="{= ${home>/kpi/atRiskBudgets} > 0 ? 'Needs attention' : 'All on track' }"
                            press=".onNavigate" app:target="#Project-manage" />
                    </f:header>
                </f:Card>
                <f:Card width="100%" height="100%" class="psaKpi" visible="{= !!${home>/me/isAdmin} }">
                    <f:header>
                        <card:NumericHeader title="Pending Approvals" subtitle="Submitted timesheets" iconSrc="sap-icon://approvals"
                            iconBackgroundColor="Accent1" number="{path: 'home>/kpi/pendingApprovals', formatter: '.formatCount'}"
                            state="{= ${home>/kpi/pendingApprovals} > 0 ? 'Critical' : 'Good' }"
                            press=".onNavigate" app:target="#Timesheet-approve" />
                    </f:header>
                </f:Card>
                <f:Card width="100%" height="100%" class="psaKpi" visible="{= !!${home>/me/isAdmin} }">
                    <f:header>
                        <card:NumericHeader title="Unbilled Hours" subtitle="Approved and billable" iconSrc="sap-icon://time-account"
                            iconBackgroundColor="Accent8" number="{path: 'home>/kpi/unbilledHours', formatter: '.formatAmount'}"
                            details="hours ready to invoice" state="Neutral" press=".onNavigate" app:target="#Invoice-manage" />
                    </f:header>
                </f:Card>
                <f:Card width="100%" height="100%" class="psaKpi" visible="{= !!${home>/me/isAdmin} }">
                    <f:header>
                        <card:NumericHeader title="Draft Invoices" subtitle="Not issued yet" iconSrc="sap-icon://receipt"
                            iconBackgroundColor="Accent7" number="{path: 'home>/kpi/draftInvoices', formatter: '.formatCount'}"
                            state="{= ${home>/kpi/draftInvoices} > 0 ? 'Critical' : 'Neutral' }"
                            press=".onNavigate" app:target="#Invoice-manage" />
                    </f:header>
                </f:Card>
                <f:Card width="100%" height="100%" class="psaKpi" visible="{= !!${home>/me/isAdmin} }">
                    <f:header>
                        <card:NumericHeader title="Overdue Amount" subtitle="Issued, past due date" iconSrc="sap-icon://lead-outdated"
                            iconBackgroundColor="Accent3" number="{path: 'home>/kpi/overdueAmount', formatter: '.formatAmount'}"
                            state="{= ${home>/kpi/overdueAmount} > 0 ? 'Error' : 'Good' }"
                            details="{= (${home>/kpi/overdueInvoices} || 0) + ' invoice(s)' }"
                            press=".onNavigate" app:target="#Invoice-manage" />
                    </f:header>
                </f:Card>

                <!-- Employee -->
                <f:Card width="100%" height="100%" class="psaKpi" visible="{= !${home>/me/isAdmin} }">
                    <f:header>
                        <card:NumericHeader title="Hours This Week" subtitle="{home>/week/label}" iconSrc="sap-icon://time-entry-request"
                            iconBackgroundColor="Accent6" number="{path: 'home>/kpi/myWeekHours', formatter: '.formatAmount'}"
                            details="hours logged" state="Neutral" press=".onLogTime" />
                    </f:header>
                </f:Card>
                <f:Card width="100%" height="100%" class="psaKpi" visible="{= !${home>/me/isAdmin} }">
                    <f:header>
                        <card:NumericHeader title="Open Timesheets" subtitle="Draft or rejected" iconSrc="sap-icon://edit"
                            iconBackgroundColor="Accent2" number="{path: 'home>/kpi/myOpenTimesheets', formatter: '.formatCount'}"
                            state="{= ${home>/kpi/myOpenTimesheets} > 0 ? 'Critical' : 'Good' }"
                            press=".onNavigate" app:target="#Timesheet-manage" />
                    </f:header>
                </f:Card>
                <f:Card width="100%" height="100%" class="psaKpi" visible="{= !${home>/me/isAdmin} }">
                    <f:header>
                        <card:NumericHeader title="Waiting for Approval" subtitle="Submitted" iconSrc="sap-icon://pending"
                            iconBackgroundColor="Accent1" number="{path: 'home>/kpi/mySubmitted', formatter: '.formatCount'}"
                            state="Neutral" press=".onNavigate" app:target="#Timesheet-manage" />
                    </f:header>
                </f:Card>
            </items>
        </HBox>

        <!-- ================= Two columns ================= -->
        <l:Grid defaultSpan="XL12 L12 M12 S12" hSpacing="1" vSpacing="1" containerQuery="true" class="psaColumns">

            <!-- ======== Left column ======== -->
            <VBox>
                <layoutData><l:GridData span="XL8 L8 M12 S12" /></layoutData>

                <!-- Employee: this week -->
                <f:Card width="100%" class="psaCard" visible="{= !!${home>/kpi/myEmployeeID} &amp;&amp; !${home>/me/isAdmin} }">
                    <f:header>
                        <card:Header title="This week" subtitle="{home>/week/label}" iconSrc="sap-icon://calendar" iconBackgroundColor="Accent6" />
                    </f:header>
                    <f:content>
                        <VBox class="psaCardBody">
                            <HBox width="100%" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="psaGap">
                                <Text text="{home>/week/hint}" class="sapUiTinyMarginBottom" />
                                <ObjectStatus text="{home>/week/status}" state="{home>/week/state}" icon="{home>/week/icon}" inverted="true" />
                            </HBox>
                            <ProgressIndicator displayOnly="true" height="1.5rem" class="sapUiSmallMarginTopBottom"
                                percentValue="{home>/week/percent}" displayValue="{home>/week/display}" state="Information" />
                            <HBox width="100%" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="psaGap">
                                <Label text="Standard week: 40 h (only a guide, not a limit)" />
                                <Button text="{home>/week/action}" type="Emphasized" icon="sap-icon://create-entry-time" press=".onLogTime" />
                            </HBox>
                        </VBox>
                    </f:content>
                </f:Card>

                <!-- Employee: recent timesheets -->
                <f:Card width="100%" class="psaCard" visible="{= !!${home>/kpi/myEmployeeID} &amp;&amp; !${home>/me/isAdmin} }">
                    <f:header>
                        <card:Header title="My recent timesheets" subtitle="Click a week to open it" iconSrc="sap-icon://history"
                            iconBackgroundColor="Accent8" />
                    </f:header>
                    <f:content>
                        <List id="recent" showSeparators="Inner" noDataText="No timesheets yet - start with 'Log time'"
                            growing="true" growingThreshold="5" growingScrollToLoad="false"
                            items="{path: '/TimesheetSrv', suspended: true, parameters: {$filter: 'IsActiveEntity eq true', $orderby: 'WEEK_START desc'}}">
                            <CustomListItem type="Navigation" press=".onTimesheetPress">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="psaRow">
                                    <HBox alignItems="Center">
                                        <Avatar src="sap-icon://calendar" displaySize="XS" displayShape="Square" backgroundColor="Accent6"
                                            class="sapUiSmallMarginEnd" />
                                        <VBox>
                                            <Text text="{parts: [{path: 'WEEK_START', targetType: 'any'}, {path: 'WEEK_END', targetType: 'any'}], formatter: '.formatWeek'}"
                                                class="psaRowTitle" />
                                            <Text text="{TOTAL_HOURS} h logged" class="psaRowSub" />
                                            <Text text="Rejected: {REJECTION_REASON}" visible="{path: 'STATUS', targetType: 'any', formatter: '.isRejected'}" class="psaReason" />
                                        </VBox>
                                    </HBox>
                                    <ObjectStatus text="{STATUS}" inverted="true"
                                        state="{path: 'STATUS', formatter: '.formatTimesheetState'}"
                                        icon="{path: 'STATUS', formatter: '.formatTimesheetIcon'}" />
                                </HBox>
                            </CustomListItem>
                        </List>
                    </f:content>
                </f:Card>

                <!-- Admin: waiting for approval (approve right here) -->
                <f:Card width="100%" class="psaCard" visible="{= !!${home>/me/isAdmin} }">
                    <f:header>
                        <card:Header title="Waiting for your approval" subtitle="Approve here, or open the week to reject with a reason"
                            iconSrc="sap-icon://approvals" iconBackgroundColor="Accent1" />
                    </f:header>
                    <f:content>
                        <List id="approvals" showSeparators="Inner" noDataText="Nothing to approve - all timesheets are handled"
                            growing="true" growingThreshold="5" growingScrollToLoad="false"
                            items="{path: '/ApprovalSrv', suspended: true, parameters: {$orderby: 'WEEK_START'}}">
                            <CustomListItem type="Navigation" press=".onApprovalPress">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="psaRow">
                                    <HBox alignItems="Center">
                                        <Avatar initials="{path: 'EMPLOYEE/fullName', formatter: '.formatInitials'}" displaySize="XS"
                                            backgroundColor="Accent1" class="sapUiSmallMarginEnd" />
                                        <VBox>
                                            <Text text="{EMPLOYEE/fullName}" class="psaRowTitle" />
                                            <Text text="{parts: [{path: 'WEEK_START', targetType: 'any'}, {path: 'WEEK_END', targetType: 'any'}], formatter: '.formatWeek'}"
                                                class="psaRowSub" />
                                        </VBox>
                                    </HBox>
                                    <HBox alignItems="Center">
                                        <ObjectNumber number="{TOTAL_HOURS}" unit="h" class="sapUiSmallMarginEnd" />
                                        <Button text="Approve" icon="sap-icon://accept" type="Accept" press=".onApprove" />
                                    </HBox>
                                </HBox>
                            </CustomListItem>
                        </List>
                    </f:content>
                </f:Card>

                <!-- Admin: budget burn per project (drill-down to the project) -->
                <f:Card width="100%" class="psaCard" visible="{= !!${home>/me/isAdmin} }">
                    <f:header>
                        <card:Header title="Budget burn per project" subtitle="Approved hours against budget and plan"
                            iconSrc="sap-icon://business-objects-experience" iconBackgroundColor="Accent6" />
                    </f:header>
                    <f:content>
                        <Table id="projects" growing="true" growingThreshold="10" noDataText="No projects yet" popinLayout="GridSmall"
                            items="{path: '/ProjectSrv', suspended: true, parameters: {$filter: 'IsActiveEntity eq true', $orderby: 'PROJECT_CODE'}}">
                            <columns>
                                <Column width="14rem"><Text text="Project" /></Column>
                                <Column minScreenWidth="Desktop" demandPopin="true"><Text text="Client" /></Column>
                                <Column width="11rem"><Text text="Budget Burn" /></Column>
                                <Column minScreenWidth="Tablet" demandPopin="true" width="11rem"><Text text="Hours Used" /></Column>
                                <Column hAlign="End" width="8.5rem"><Text text="Budget Health" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem type="Navigation" press=".onProjectPress">
                                    <cells>
                                        <ObjectIdentifier title="{PROJECT_NAME}" text="{PROJECT_CODE} · {BILLING_TYPE}" />
                                        <Text text="{CLIENT/CLIENT_NAME}" />
                                        <ProgressIndicator displayOnly="true" height="1.25rem"
                                            percentValue="{path: 'BUDGET/CONSUMED_PERCENT', formatter: '.formatPercent'}"
                                            displayValue="{path: 'BUDGET/CONSUMED_PERCENT', formatter: '.formatPercentText'}"
                                            state="{path: 'BUDGET/BUDGET_STATUS', formatter: '.formatBudgetState'}" />
                                        <ProgressIndicator displayOnly="true" height="1.25rem"
                                            percentValue="{path: 'HOURS_PERCENT', formatter: '.formatPercent'}"
                                            displayValue="{parts: ['CONSUMED_HOURS', 'PLANNED_HOURS'], formatter: '.formatHours'}"
                                            state="{path: 'HOURS_PERCENT', formatter: '.formatBurnState'}" />
                                        <ObjectStatus text="{BUDGET/BUDGET_STATUS}" inverted="true"
                                            state="{path: 'BUDGET/BUDGET_STATUS', formatter: '.formatBudgetState'}"
                                            icon="{path: 'BUDGET/BUDGET_STATUS', formatter: '.formatBudgetIcon'}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </f:content>
                </f:Card>

                <!-- Admin: tasks at risk (scope creep) -->
                <f:Card width="100%" class="psaCard" visible="{= !!${home>/me/isAdmin} }">
                    <f:header>
                        <card:Header title="Tasks at risk" subtitle="80 % or more of the estimate used, not done yet"
                            iconSrc="sap-icon://task" iconBackgroundColor="Accent2" />
                    </f:header>
                    <f:content>
                        <List id="tasks" showSeparators="Inner" noDataText="No task is at risk - all work is within its estimate"
                            items="{path: '/TaskSrv', suspended: true, parameters: {$filter: 'BURN_PERCENT ge 80', $orderby: 'BURN_PERCENT desc'}}">
                            <CustomListItem type="Navigation" press=".onTaskPress">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="psaRow">
                                    <VBox>
                                        <Text text="{TASK_NAME}" class="psaRowTitle" />
                                        <Text text="{PROJECT_CODE} · {= ${ASSIGNEE/fullName} || 'Unassigned' }" class="psaRowSub" />
                                    </VBox>
                                    <ProgressIndicator displayOnly="true" height="1.25rem" width="11rem"
                                        percentValue="{path: 'BURN_PERCENT', formatter: '.formatPercent'}"
                                        displayValue="{parts: ['ACTUAL_HOURS', 'ESTIMATED_HOURS'], formatter: '.formatHours'}"
                                        state="{path: 'BURN_PERCENT', formatter: '.formatBurnState'}" />
                                </HBox>
                            </CustomListItem>
                        </List>
                    </f:content>
                </f:Card>
            </VBox>

            <!-- ======== Right column ======== -->
            <VBox>
                <layoutData><l:GridData span="XL4 L4 M12 S12" /></layoutData>

                <!-- Apps of the user's role -->
                <f:Card width="100%" class="psaCard">
                    <f:header>
                        <card:Header title="Your apps" subtitle="{= ${home>/me/isAdmin} ? 'Everything you manage' : 'What you can do' }"
                            iconSrc="sap-icon://grid" iconBackgroundColor="Accent10" />
                    </f:header>
                    <f:content>
                        <List showSeparators="Inner" items="{home>/apps}">
                            <CustomListItem type="Navigation" press=".onAppPress">
                                <HBox justifyContent="SpaceBetween" alignItems="Center" class="psaRow">
                                    <HBox alignItems="Center">
                                        <Avatar src="{home>icon}" displaySize="S" displayShape="Square"
                                            backgroundColor="{home>color}" class="sapUiSmallMarginEnd" />
                                        <VBox>
                                            <Text text="{home>title}" class="psaRowTitle" />
                                            <Text text="{home>description}" class="psaRowSub" />
                                        </VBox>
                                    </HBox>
                                    <ObjectStatus text="{home>info}" state="{home>infoState}" inverted="true"
                                        visible="{= !!${home>info} }" />
                                </HBox>
                            </CustomListItem>
                        </List>
                    </f:content>
                </f:Card>

                <!-- Employee: how it works -->
                <f:Card width="100%" class="psaCard" visible="{= !${home>/me/isAdmin} }">
                    <f:header>
                        <card:Header title="How it works" subtitle="Three steps every week" iconSrc="sap-icon://hint"
                            iconBackgroundColor="Accent9" />
                    </f:header>
                    <f:content>
                        <VBox class="psaCardBody">
                            <HBox alignItems="Center" class="psaStep">
                                <Avatar src="sap-icon://create-entry-time" displaySize="XS" backgroundColor="Accent6" class="sapUiSmallMarginEnd" />
                                <Text text="1. Open this week's timesheet with 'Log time'." />
                            </HBox>
                            <HBox alignItems="Center" class="psaStep">
                                <Avatar src="sap-icon://add" displaySize="XS" backgroundColor="Accent6" class="sapUiSmallMarginEnd" />
                                <Text text="2. Add a row per day and task: hours, billable, notes. Save." />
                            </HBox>
                            <HBox alignItems="Center" class="psaStep">
                                <Avatar src="sap-icon://paper-plane" displaySize="XS" backgroundColor="Accent6" class="sapUiSmallMarginEnd" />
                                <Text text="3. Submit for approval. Approved hours update the project budget right away." />
                            </HBox>
                        </VBox>
                    </f:content>
                </f:Card>

                <!-- Admin: scope-creep alerts -->
                <f:Card width="100%" class="psaCard" visible="{= !!${home>/me/isAdmin} }">
                    <f:header>
                        <card:Header title="Scope-creep alerts" subtitle="Raised at 75 %, 90 % and 100 %"
                            iconSrc="sap-icon://message-warning" iconBackgroundColor="Accent3" />
                    </f:header>
                    <f:content>
                        <List id="alerts" showSeparators="Inner" noDataText="No alerts - all work is within budget"
                            growing="true" growingThreshold="5" growingScrollToLoad="false"
                            items="{path: '/AlertSrv', suspended: true, parameters: {$orderby: 'THRESHOLD desc'}}">
                            <StandardListItem title="{MESSAGE}" description="{PROJECT/PROJECT_NAME}" wrapping="true"
                                icon="{= ${CRITICALITY} === 1 ? 'sap-icon://error' : 'sap-icon://alert' }"
                                info="{THRESHOLD} %" infoState="{= ${CRITICALITY} === 1 ? 'Error' : 'Warning' }"
                                type="Navigation" press=".onAlertPress" />
                        </List>
                    </f:content>
                </f:Card>
            </VBox>
        </l:Grid>
    </Page>
</mvc:View>
