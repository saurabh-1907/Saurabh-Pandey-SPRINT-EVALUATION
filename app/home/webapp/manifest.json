{
  "_version": "1.89.0",
  "sap.app": {
    "id": "psa.home",
    "type": "application",
    "title": "Manager Home",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/psa/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "outbounds": {
        "ProjectDetails": {
          "semanticObject": "Project",
          "action": "manage",
          "parameters": {}
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.chart": {},
        "sap.viz": {},
        "sap.ui.table": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ProjectAnalyticsList",
          "target": "ProjectAnalyticsList"
        }
      ],
      "targets": {
        "ProjectAnalyticsList": {
          "type": "Component",
          "id": "ProjectAnalyticsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ProjectAnalytics",
              "variantManagement": "None",
              "initialLoad": "Enabled",
              "views": {
                "paths": [
                  {
                    "primary": [
                      {
                        "annotationPath": "com.sap.vocabularies.UI.v1.PresentationVariant"
                      }
                    ],
                    "secondary": [
                      {
                        "annotationPath": "com.sap.vocabularies.UI.v1.LineItem"
                      }
                    ],
                    "defaultPath": "both"
                  }
                ]
              },
              "keyPerformanceIndicators": {
                "activeProjects": {
                  "model": "",
                  "entitySet": "ProjectAnalytics",
                  "qualifier": "ActiveProjects"
                },
                "atRiskBudgets": {
                  "model": "",
                  "entitySet": "ProjectAnalytics",
                  "qualifier": "AtRiskBudgets"
                },
                "pendingApprovals": {
                  "model": "",
                  "entitySet": "TimesheetAnalytics",
                  "qualifier": "PendingApprovals"
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "GridTable",
                    "rowCountMode": "Fixed",
                    "rowCount": 5
                  }
                }
              },
              "navigation": {
                "ProjectAnalytics": {
                  "detail": {
                    "outbound": "ProjectDetails"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "analytical"
  }
}
